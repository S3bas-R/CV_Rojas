// const           → crea una cajita que NO cambia nunca (o casi nunca)
// let             → crea una cajita que SÍ puede cambiar (pero no usamos mucho aquí)
// var             → antigua, casi no se usa ya

// useState()      → crea una cajita que cambia y React la vigila
// setAlgo()       → el botón para cambiar el valor de una cajita useState

// useEffect()     → robot que corre automáticamente en ciertos momentos
// useRef()        → cajita secreta que no hace que la pantalla se vuelva a dibujar

// if (condición)  → "si pasa esto, haz esto otro"
// else            → "si no, haz esto"

// try / catch     → "intenta hacer esto, si sale mal no te enojes y haz esto otro"

// &&              → "y" lógico (solo se muestra si las dos cosas son verdad)
// ||              → "o" lógico

// map()           → pasa por cada cosa de una lista y hace algo
// filter()        → se queda solo con las cosas que cumplen una regla

// {condición && <Componente />} → truco para mostrar algo solo si es verdad

// style={{ color: data.colorPrincipal }} → cambia el color en vivo

// className       → como "class" de HTML pero para React

// onClick={() => hacerAlgo()} → cuando el niño hace clic, pasa esto

// ref={printRef}  → le pone un nombre secreto a ese pedazo de pantalla

// JSON.parse / JSON.stringify → convierte entre objetos y texto mágico para guardar

// localStorage    → el cajón secreto del navegador que guarda cosas aunque cierres la página


