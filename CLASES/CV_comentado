import React, { useState, useEffect, useRef } from 'react'; // 🧸 Importamos las herramientas mágicas de React
// useState = cajita donde guardamos cosas que cambian (como el nombre)
// useEffect = robot que hace cosas cuando algo pasa (como guardar en el ordenador)
// useRef = cajita secreta para guardar cosas sin que React las vea todo el tiempo

import { Camera, Trash2, Plus, Download, Palette, User, Briefcase, GraduationCap, Code, Rocket, Settings, MapPin, Phone, Mail, Globe, Calendar, Linkedin, Github, Twitter } from 'lucide-react'; // 🧸 Iconos bonitos como caritas felices y cohetes
import { motion } from 'framer-motion'; // 🧸 Hace animaciones suaves como cuando mueves un juguete despacito

// 🧸 Aquí guardamos todas las palabras en español y inglés para que la app hable dos idiomas
const translations = {
    es: { /* todas las palabras en español */ },
    en: { /* todas las palabras en inglés */ }
};

// 🧸 Esta es la información de ejemplo que aparece cuando abres la app por primera vez
// Es como el dibujo inicial en una hoja en blanco
const initialData = {
    nombre: "Sebastián Rojas",
    titulo: "Desarrollador de Software | Profesional Multifacético",
    email: "sebas.educa00@gmail.com",
    telefono: "+593 98 322 3670",
    ubicacion: "Quito, Ecuador",
    foto: "https://Front_view_of_a_resting_Canis_lupus_ssp.jpg", // 🧸 Foto de un lobo porque sí jajaja
    disponibilidad: "Inmediata - Tiempo Parcial",
    linkedin: "linkedin.com/in/tu-perfil",
    github: "github.com/tu-usuario",
    portfolio: "tu-portfolio.com",
    twitter: "",
    sobreMi: "Mi principal meta es contribuir con mi experiencia...", // 🧸 Aquí va tu historia personal
    sobreMiExtra: "Estoy dispuesto a adaptarme a nuevas situaciones...",
    idiomas: [{ idioma: "Español", nivel: "Nativo" }, { idioma: "Inglés", nivel: "Avanzado" }],
    hobbies: ["Fotografía", "Deportes", "Lectura", "Videojuegos", "Música"],
    experiencias: [ /* trabajos anteriores */],
    educacion: [ /* estudios */],
    certificaciones: [ /* diplomas especiales */],
    voluntariado: [ /* ayuda a otros */],
    premios: [ /* trofeos */],
    skills: [ /* cosas que sabes hacer bien */],
    softSkills: ["Trabajo en Equipo", "Liderazgo", "Comunicación"],
    proyectos: [ /* cosas que has creado */],
    colorPrincipal: "#0066FF",    // 🧸 El color favorito de tu CV (azul bonito)
    plantilla: "professional",    // 🧸 Cómo se ve tu CV (elegante, moderno, etc)
    idiomaCv: "es"                // 🧸 En qué idioma quieres que se vea el CV final
};

// 🧸 AQUÍ EMPIEZA EL JUGUETE GRANDE: nuestra app completa
export default function CVEditor() {

    // 🧸 Cajitas mágicas que cambian cuando el niño escribe
    const [activeTab, setActiveTab] = useState('personal');     // 🧸 ¿En qué pestaña estamos? (personal, experiencia...)
    const [data, setData] = useState(initialData);              // 🧸 TODA la información del CV vive aquí
    const [language, setLanguage] = useState('es');             // 🧸 ¿La app habla español o inglés ahora?

    const printRef = useRef();    // 🧸 Cajita secreta para imprimir
    const fileInputRef = useRef(); // 🧸 Cajita secreta para subir fotos

    const t = translations[language]; // 🧸 Atajo para no escribir "translations[language]" todo el tiempo

    // 🧸 Robot que se despierta cuando abres la página: ¿hay algo guardado del día anterior?
    useEffect(() => {
        const saved = localStorage.getItem('cv-data-ultimate'); // 🧸 Mira en el cajón del navegador
        if (saved) {
            try {
                setData(JSON.parse(saved)); // 🧸 Si encuentra algo, lo pone en nuestra cajita "data"
            } catch (e) { }
        }
    }, []); // 🧸 El [] significa: "haz esto solo una vez cuando abras la página"

    // 🧸 Robot que GUARDA automáticamente cada vez que cambias algo
    useEffect(() => {
        localStorage.setItem('cv-data-ultimate', JSON.stringify(data));
    }, [data]); // 🧸 Cada vez que "data" cambia → guarda!

    // 🧸 Función súper útil: cambiar un dato sencillo (como el nombre o email)
    const updateField = (field, value) => setData(prev => ({ ...prev, [field]: value }));
    // Ejemplo: updateField('nombre', 'Juan') → cambia el nombre a Juan

    // 🧸 Añadir una experiencia, educación, proyecto... (botón +)
    const addItem = (field) => {
        const newItem = field === 'experiencias' ? { id: Date.now(), puesto: '', empresa: '', fecha: '', descripcion: [''] }
            : field === 'educacion' ? { id: Date.now(), titulo: '', institucion: '', fecha: '' }
                : field === 'proyectos' ? { id: Date.now(), nombre: '', fecha: '', descripcion: '', tecnologias: '' }
                    : field === 'certificaciones' ? { id: Date.now(), nombre: '', emisor: '', fecha: '', credencial: '' }
                        : field === 'voluntariado' ? { id: Date.now(), organizacion: '', rol: '', fecha: '', descripcion: '' }
                            : field === 'premios' ? { id: Date.now(), titulo: '', emisor: '', fecha: '', descripcion: '' }
                                : { id: Date.now(), nombre: '', nivel: 50 }; // 🧸 para habilidades técnicas
        setData(prev => ({ ...prev, [field]: [...(prev[field] || []), newItem] }));
    };

    // 🧸 Borrar un ítem (botón basurita)
    const removeItem = (field, id) => setData(prev => ({ ...prev, [field]: prev[field].filter(item => item.id !== id) }));

    // 🧸 Cambiar algo dentro de una experiencia/educación/proyecto
    const updateItem = (field, id, key, value) => setData(prev => ({
        ...prev,
        [field]: prev[field].map(item => item.id === id ? { ...item, [key]: value } : item)
    }));

    // 🧸 Subir una foto bonita tuya
    const handlePhotoUpload = (e) => {
        const file = e.target.files[0];           // 🧸 El niño eligió una foto
        if (file) {
            const reader = new FileReader();        // 🧸 El mago que convierte la foto en texto mágico
            reader.onloadend = () => updateField('foto', reader.result); // 🧸 Guarda la foto en base64
            reader.readAsDataURL(file);
        }
    };

    // 🧸 Botón grande de "Exportar PDF" → simplemente imprime la página
    const exportPDF = () => window.print();

    // 🧸 Botón de resetear todo
    const resetData = () => {
        if (confirm('¿Resetear todo?')) { // 🧸 Pregunta por si acaso
            setData(initialData);
            localStorage.removeItem('cv-data-ultimate');
        }
    };

    // 🧸 Las pestañitas de arriba (Personal, Experiencia, etc)
    const tabs = [
        { id: 'personal', icon: User, label: t.tabs.personal },
        { id: 'experiencia', icon: Briefcase, label: t.tabs.experience },
        { id: 'educacion', icon: GraduationCap, label: t.tabs.education },
        { id: 'skills', icon: Code, label: t.tabs.skills },
        { id: 'proyectos', icon: Rocket, label: t.tabs.projects },
        { id: 'extras', icon: Plus, label: 'Extras' },
        { id: 'diseno', icon: Settings, label: t.tabs.design }
    ];

    // 🧸 Aquí elegimos qué plantilla mostrar (profesional, moderna, etc)
    const renderTemplate = () => {
        const tCv = translations[data.idiomaCv].cv;
        if (data.plantilla === 'modern') return <ModernTemplate data={data} t={tCv} />;
        if (data.plantilla === 'minimal') return <MinimalTemplate data={data} t={tCv} />;
        // ... otros templates
        return <ProfessionalTemplate data={data} t={tCv} />; // 🧸 por defecto la profesional
    };

    // 🧸 ¡¡AQUÍ EMPIEZA LO QUE SE VE EN LA PANTALLA!!
    return (
        <div className="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900"> {/* Fondo galáctico bonito */}

            {/* Fondo animado que se mueve solooo */}
            <motion.div
                className="fixed inset-0 opacity-20 pointer-events-none"
                animate={{ backgroundPosition: ['0% 0%', '100% 100%'] }}
                transition={{ duration: 60, repeat: Infinity, ease: 'linear' }}
                style={{ background: `radial-gradient(circle, ${data.colorPrincipal}40 0%, transparent 50%)`, backgroundSize: '200% 200%' }}
            />

            <div className="flex flex-col lg:flex-row min-h-screen relative z-10">

                {/* 🧸 LADO IZQUIERDO: donde editas todo */}
                <div className="w-full lg:w-2/5 bg-white/95 backdrop-blur-xl overflow-y-auto shadow-2xl border-r border-gray-200/50">

                    {/* Cabecera fija con título y selector de idioma */}
                    <div className="sticky top-0 bg-white/80 backdrop-blur-2xl border-b border-gray-200/50 p-8 z-20">
                        <div className="flex items-center justify-between mb-3">
                            <div>
                                <h1 className="text-3xl font-semibold text-gray-900 tracking-tight flex items-center gap-3">
                                    <div className="w-10 h-10 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-lg">
                                        <Palette className="w-6 h-6 text-white" />
                                    </div>
                                    {t.editorTitle}
                                </h1>
                                <p className="text-sm text-gray-500 mt-1 font-light">{t.subtitle}</p>
                            </div>
                            {/* Selector de idioma de la app (no del CV) */}
                            <select value={language} onChange={(e) => setLanguage(e.target.value)} className="px-4 py-2 rounded-xl bg-gray-100/80 backdrop-blur text-gray-700 text-sm font-medium cursor-pointer border border-gray-200/50 hover:bg-gray-200/80 transition-all shadow-sm">
                                <option value="es">🇪🇸 ES</option>
                                <option value="en">🇬🇧 EN</option>
                            </select>
                        </div>
                    </div>

                    {/* Pestañas horizontales */}
                    <div className="flex overflow-x-auto bg-white/50 backdrop-blur border-b border-gray-200/30 sticky top-[120px] z-10 px-4">
                        {tabs.map(tab => {
                            const Icon = tab.icon;
                            return (
                                <button key={tab.id} onClick={() => setActiveTab(tab.id)} className={`flex items-center gap-2 px-5 py-3 whitespace-nowrap transition-all font-medium ${activeTab === tab.id ? 'text-blue-600 border-b-2 border-blue-600 bg-blue-50/50' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100/50'}`}>
                                    <Icon className="w-4 h-4" />
                                    <span className="text-sm">{tab.label}</span>
                                </button>
                            );
                        })}
                    </div>

                    {/* 🧸 CONTENIDO DE CADA PESTAÑA */}
                    <div className="p-8">

                        {/* ==================== PESTAÑA PERSONAL ==================== */}
                        {activeTab === 'personal' && (
                            <div className="space-y-5">
                                <h2 className="text-2xl font-semibold text-gray-900 mb-6">{t.personal.title}</h2>

                                {/* Todos los campos de información personal */}
                                <div>
                                    <label className="block text-sm font-medium text-gray-700 mb-2">{t.personal.fullName}</label>
