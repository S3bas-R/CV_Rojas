import React, { useState, useEffect, useRef } from 'react'; 
// 🧈 useState     → cajita mágica que guarda cosas que cambian (como el nombre o el color)
// 🧈 useEffect    → robot que hace algo automáticamente cuando algo cambia o cuando abres la página
// 🧈 useRef       → cajita secreta que guarda cosas sin que React las esté mirando todo el tiempo

import { 
  Camera, Trash2, Plus, Download, Palette, User, Briefcase, GraduationCap, 
  Code, Rocket, Settings, MapPin, Phone, Mail, Globe, Calendar, Linkedin, Github, Twitter 
} from 'lucide-react'; // 🧈 Iconitos bonitos que parecen dibujitos

import { motion } from 'framer-motion'; // 🧈 Hace animaciones suavecitas (como cuando un juguete se mueve solo)

// =====================================================================
// 🧠 TRADUCCIONES
// Estas son todas las palabras que la app puede decir en español o inglés
const translations = { es: { /* ... */ }, en: { /* ... */ } };

// ===================================================================== 🧠 DATOS DE EJEMPLO
// Esto es lo que aparece cuando abres la app por primera vez (como un dibujo de muestra)
const initialData = { /* todos los datos de Sebastián */ };

// ===================================================================== 🧠 AQUÍ EMPIEZA LA APP GRANDE
export default function CVEditor() { 
  // 🧈 "export default" = este es el juguete principal que le vamos a dar al mundo

  // ==================== CAJITAS QUE CAMBIAN (useState) ====================
  const [activeTab, setActiveTab] = useState('personal');     
  // 🧈 ¿En qué pestañita estamos ahora? Empieza en "personal"

  const [data, setData] = useState(initialData);              
  // 🧈 "data" = TODA la información del CV (nombre, experiencias, foto, etc.)
  // 🧈 "setData" = el botón mágico para cambiar "data"

  const [language, setLanguage] = useState('es');             
  // 🧈 ¿La app habla español o inglés? Empieza en español

  // ==================== CAJITAS SECRETAS (useRef) ====================
  const printRef = useRef();      // 🧈 Para saber dónde está el CV cuando imprimimos
  const fileInputRef = useRef();  // 🧈 Para el botón invisible de subir foto

  // ==================== ATAJOS ====================
  const t = translations[language]; 
  // 🧈 En vez de escribir translations[language].tabs.personal todo el tiempo, solo escribimos t.tabs.personal

  // ==================== ROBOT QUE SE ACTIVA AL ABRIR LA PÁGINA ====================
  useEffect(() => {
    // 🧈 Mira si ya habías guardado algo antes en el ordenador del niño
    const saved = localStorage.getItem('cv-data-ultimate');
    if (saved) {
      try { 
        setData(JSON.parse(saved)); 
        // 🧈 JSON.parse = convierte texto mágico en objetos de verdad
      } catch (e) { /* si falla, no pasa nada */ }
    }
  }, []); 
  // 🧈 El [] significa: "haz esto solo una vez cuando abras la página"

  // ==================== ROBOT QUE GUARDA AUTOMÁTICAMENTE ====================
  useEffect(() => {
    // 🧈 Cada vez que "data" cambia, guardamos todo en el cajón del navegador
    localStorage.setItem('cv-data-ultimate', JSON.stringify(data));
    // 🧈 JSON.stringify = convierte objetos en texto mágico para guardar
  }, [data]); 
  // 🧈 [data] = "cada vez que data cambie, corre este robot"

  // ==================== FUNCIONES PEQUEÑAS (como botoncitos mágicos) ====================

  // 🧈 Cambiar un campo sencillo (nombre, email, color...)
  const updateField = (field, value) => setData(prev => ({ ...prev, [field]: value }));
  // 🧈 prev = lo que había antes
  // 🧈 ...prev = copia todo lo viejo y solo cambia "field" por "value"

  // 🧈 Añadir una experiencia, educación, proyecto, certificación...
  const addItem = (field) => {
    const newItem = /* depende de qué sea, crea un objeto vacío con id nuevo */;
    setData(prev => ({ ...prev, [field]: [...(prev[field] || []), newItem] }));
  };

  // 🧈 Borrar un ítem con la basurita
  const removeItem = (field, id) => setData(prev => ({ 
    ...prev, 
    [field]: prev[field].filter(item => item.id !== id) 
  }));
  // 🧈 filter = "quédate solo con los que NO tengan ese id"

  // 🧈 Cambiar algo dentro de un ítem (ej: cambiar el puesto de una experiencia)
  const updateItem = (field, id, key, value) => setData(prev => ({
    ...prev,
    [field]: prev[field].map(item => 
      item.id === id ? { ...item, [key]: value } : item
    )
  }));
  // 🧈 map = pasa por cada uno y cambia solo el que coincide

  // 🧈 Subir foto desde el ordenador
  const handlePhotoUpload = (e) => {
    const file = e.target.files[0];           // 🧈 El niño eligió una foto
    if (file) {
      const reader = new FileReader();        // 🧈 Mago que lee archivos
      reader.onloadend = () => updateField('foto', reader.result); // 🧈 Guarda foto como texto largo (base64)
      reader.readAsDataURL(file);
    }
  };

  // 🧈 Botón "Exportar PDF" → simplemente imprime
  const exportPDF = () => window.print();

  // 🧈 Resetear todo al principio
  const resetData = () => {
    if (confirm('¿Borrar todo y empezar de nuevo?')) {
      setData(initialData);
      localStorage.removeItem('cv-data-ultimate');
    }
  };

  // ==================== LISTA DE PESTAÑITAS ====================
  const tabs = [ /* personal, experiencia, educación... */ ];

  // ==================== ELEGIR QUÉ PLANTILLA MOSTRAR ====================
  const renderTemplate = () => {
    const tCv = translations[data.idiomaCv].cv;
    if (data.plantilla === 'modern') return <ModernTemplate data={data} t={tCv} />;
    if (data.plantilla === 'minimal') return <MinimalTemplate data={data} t={tCv} />;
    if (data.plantilla === 'creative') return <CreativeTemplate data={data} t={tCv} />;
    if (data.plantilla === 'tech') return <TechTemplate data={data} t={tCv} />;
    if (data.plantilla === 'executive') return <ExecutiveTemplate data={data} t={tCv} />;
    return <ProfessionalTemplate data={data} t={tCv} />; // 🧈 por defecto
  };

  // =====================================================================
  // 🧈 ¡¡AQUÍ EMPIEZA LO QUE SE VE EN LA PANTALLA!! (return)
  // =====================================================================
  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
      
      {/* Fondo que se mueve solito */}
      <motion.div /* ... */ />

      <div className="flex flex-col lg:flex-row min-h-screen relative z-10">

        {/* ==================== LADO IZQUIERDO: EDITOR ==================== */}
        <div className="w-full lg:w-2/5 bg-white/95 ...">
          {/* Cabecera con título y selector de idioma */}
          {/* Pestañas */}
          {/* Formularios de cada pestaña (personal, experiencia, diseño...) */}
        </div>

        {/* ==================== LADO DERECHO: VISTA PREVIA DEL CV ==================== */}
        <div className="flex-1 bg-gradient-to-br from-slate-800 to-slate-900 p-4 lg:p-8 overflow-y-auto">
          <div className="max-w-4xl mx-auto">
            <div ref={printRef} id="cv-preview">
              {renderTemplate()}  {/* 🧈 Aquí aparece el CV bonito */}
            </div>
          </div>
        </div>
      </div>

      {/* ==================== TRUCO PARA IMPRIMIR SOLO EL CV ==================== */}
      <style>{`
        @media print {
          body * { visibility: hidden; }
          #cv-preview, #cv-preview * { visibility: visible; }
          #cv-preview { position: absolute; left: 0; top: 0; width: 210mm; padding: 20mm; background: white; }
          @page { size: A4; margin: 0; }
        }
      `}</style>
    </div>
  );
}

